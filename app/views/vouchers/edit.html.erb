<% content_for :title, t("vouchers.edit.title", default: "振替伝票の編集 | Summa") %>

<div class="page-shell">
  <div class="hero">
    <p class="eyebrow">DOUBLE-ENTRY</p>
    <h1><%= t("vouchers.edit.heading", default: "振替伝票の編集") %></h1>
    <p class="sub"><%= t("vouchers.edit.sub", default: "保存済み伝票の明細を修正します。") %></p>
  </div>

  <% if flash[:notice] %>
    <div class="flash flash--notice"><%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert] %>
    <div class="flash flash--alert"><%= flash[:alert] %></div>
  <% end %>

  <%= render "form",
    voucher: @voucher,
    accounts: @accounts,
    input_accounts: @editable_accounts,
    submit_label: t("vouchers.edit.submit", default: "更新"),
    return_to: @return_to,
    return_account_code: @return_account_code,
    return_description: @return_description,
    return_from_month: @return_from_month,
    return_to_month: @return_to_month,
    return_anchor: @return_anchor %>

  <div class="actions" style="margin-top: 12px;">
    <%= button_to voucher_path(@voucher), method: :delete,
          data: { turbo_confirm: t("vouchers.edit.delete_confirm", default: "本当に削除しますか？") },
          class: "btn btn--danger" do %>
      <%= hidden_field_tag :return_to, @return_to if @return_to.present? %>
      <%= hidden_field_tag :return_account_code, @return_account_code if @return_account_code.present? %>
      <%= hidden_field_tag :return_description, @return_description if @return_description.present? %>
      <%= hidden_field_tag :return_from_month, @return_from_month if @return_from_month.present? %>
      <%= hidden_field_tag :return_to_month, @return_to_month if @return_to_month.present? %>
      <%= hidden_field_tag :return_anchor, @return_anchor if @return_anchor.present? %>
      <%= t("vouchers.edit.delete", default: "削除") %>
    <% end %>
  </div>
</div>
