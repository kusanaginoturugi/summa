<% content_for :title, t(".title") %>

<div class="page-shell">
  <div class="hero">
    <p class="eyebrow">INVOICES</p>
    <h1><%= t(".heading") %></h1>
    <p class="sub"><%= t(".sub") %></p>
    <div class="pill-row">
      <span class="pill"><%= t(".saved_count", count: @invoices.size) %></span>
      <%= link_to t(".new_button"), new_invoice_path, class: "pill pill--accent" %>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="flash flash--notice"><%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert] %>
    <div class="flash flash--alert"><%= flash[:alert] %></div>
  <% end %>

  <% if @invoices.empty? %>
    <section class="card">
      <p class="sub"><%= t(".empty") %> <%= link_to t(".new_button"), new_invoice_path %></p>
    </section>
  <% else %>
    <section class="card card--stacked">
      <div class="table-responsive">
        <table class="table table-striped align-middle mb-0 invoice-index-table">
          <colgroup>
            <col class="invoice-col-number">
            <col class="invoice-col-date">
            <col class="invoice-col-client">
            <col class="invoice-col-title">
            <col class="invoice-col-total">
            <col class="invoice-col-issued">
            <col class="invoice-col-actions">
          </colgroup>
          <thead class="table-light">
            <tr>
              <th><%= t(".th.invoice_number") %></th>
              <th><%= t(".th.invoice_date") %></th>
              <th><%= t(".th.client_name") %></th>
              <th><%= t(".th.title") %></th>
              <th class="text-end"><%= t(".th.total") %></th>
              <th><%= t(".th.issued_at") %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @invoices.each do |invoice| %>
              <tr>
                <td><%= invoice.invoice_number %></td>
                <td><%= invoice.invoice_date&.strftime("%Y-%m-%d") %></td>
                <td class="invoice-cell-truncate" title="<%= invoice.client_name %>"><%= invoice.short_name.presence || invoice.client_name %></td>
                <td class="invoice-cell-truncate" title="<%= invoice.title %>"><%= invoice.title %></td>
                <td class="text-end"><%= number_with_delimiter(invoice.total.to_i) %></td>
                <td><%= invoice.issued_at&.strftime("%Y-%m-%d %H:%M") || "—" %></td>
                <td class="text-end invoice-actions">
                  <%= link_to "複製", new_invoice_path(copy_from: invoice), class: "btn btn-outline-secondary btn-sm invoice-action-button" %>
                  <%= link_to t(".edit"), edit_invoice_path(invoice), class: "btn btn-outline-secondary btn-sm invoice-action-button" %>
                  <%= link_to t(".pdf"), pdf_invoice_path(invoice), class: "btn btn-outline-secondary btn-sm invoice-action-button" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>
